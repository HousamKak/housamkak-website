---
// Static circuit map: every project is a node wired to the flagship it grew from, flagships wire to the hub.
// Rendered at build time; no client JS needed.
import type { Work } from '../lib/data';
interface Props { work: Work[]; focus?: string; label?: string }
const { work, focus = 'h-system', label = 'FIG.' } = Astro.props;
const cx = 500, cy = 350;
const t1 = work.filter((w) => w.data.tier === 1), t2 = work.filter((w) => w.data.tier === 2), t3 = work.filter((w) => w.data.tier === 3);
const pos: Record<string, { x: number; y: number }> = { __hub: { x: cx, y: cy } };
const ring = (arr: Work[], rx: number, ry: number, off: number) => arr.forEach((w, i) => {
  const a = off + (i / arr.length) * Math.PI * 2; pos[w.id] = { x: cx + Math.cos(a) * rx, y: cy + Math.sin(a) * ry };
});
ring(t1, 170, 120, -Math.PI / 2); ring(t2, 330, 225, -Math.PI / 2 + 0.2); ring(t3, 455, 310, -Math.PI / 2 + 0.1);
const shared = (a: Work, b: Work) => a.data.categories.filter((c) => b.data.categories.includes(c)).length;
const parent: Record<string, string> = {};
for (const w of [...t2, ...t3]) {
  const pool = w.data.tier === 2 ? t1 : [...t1, ...t2];
  let best = pool[0], sc = -Infinity;
  for (const q of pool) {
    const s = shared(w, q) * 10 - Math.hypot(pos[w.id].x - pos[q.id].x, pos[w.id].y - pos[q.id].y) / 60;
    if (s > sc) { sc = s; best = q; }
  }
  parent[w.id] = best.id;
}
t1.forEach((w) => (parent[w.id] = '__hub'));
const path = (a: { x: number; y: number }, b: { x: number; y: number }) => { const mx = (a.x + b.x) / 2; return `M${a.x.toFixed(1)},${a.y.toFixed(1)} C${mx.toFixed(1)},${a.y.toFixed(1)} ${mx.toFixed(1)},${b.y.toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`; };
const chain = (s: string) => { const out: string[] = []; while (s && s !== '__hub') { out.push(s); s = parent[s]; } return out; };
const hot = new Set([...chain(focus), ...work.filter((w) => parent[w.id] === focus).map((w) => w.id)]);
const short = (n: string) => (n.length > 22 ? n.slice(0, 20) + '…' : n);
const nodes = work.map((w) => {
  const label = short(w.data.title), t = w.data.tier;
  const wd = t === 1 ? label.length * 7.8 + 26 : t === 2 ? label.length * 6.7 + 20 : label.length * 6.6 + 16;
  const h = t === 1 ? 32 : t === 2 ? 26 : 22;
  return { w, label, wd, h, ...pos[w.id] };
});
---
<figure class="fig circuit">
  <div class="frame board">
    <svg viewBox="0 0 1000 700" role="img" aria-label="Map of every project, wired to the flagship system it grew from">
      <g>
        {work.map((w) => <path d={path(pos[w.id], pos[parent[w.id]])} class={`wire ${hot.has(w.id) ? 'hot' : ''}`} />)}
              </g>
      <g class="hub"><rect x={cx - 58} y={cy - 20} width="116" height="40" /><text x={cx} y={cy + 6} text-anchor="middle">Housam</text></g>
      {nodes.map((n) => (
        <a href={`/work/${n.w.id}`} class={`node t${n.w.data.tier} ${n.w.id === focus ? 'sel' : ''}`} aria-label={n.w.data.title}>
          <rect x={n.x - n.wd / 2} y={n.y - n.h / 2} width={n.wd} height={n.h} />
          <circle cx={n.x - n.wd / 2} cy={n.y} r={n.w.data.tier === 3 ? 2 : 3} class="port" />
          <text x={n.x} y={n.y + 4} text-anchor="middle">{n.label}</text>
        </a>
      ))}
    </svg>
  </div>
  <div class="dim"><span>every project · wired to the flagship it grew from</span></div>
  <figcaption><b>{label}</b><span>The whole portfolio drawn the way H draws a canvas: nodes with ports, typed wires between them. Blue wires lead to and from H. Click a node to open its sheet.</span></figcaption>
</figure>
<style>
  .board { overflow-x: auto; background: var(--paper) !important; }
  svg { display: block; width: 100%; min-width: 760px; height: auto; }
  .node rect { fill: var(--paper); stroke: var(--ink); stroke-width: 1; }
  .node.t1 rect { stroke-width: 1.8; }
  .node text { fill: var(--ink); font-family: var(--font-body); font-size: 13px; }
  .node.t1 text { font-weight: 700; font-size: 14.5px; }
  .node.t3 text { fill: var(--muted); font-size: 12px; }
  .node .port { fill: var(--point); stroke: #14171B; stroke-width: 1; }
  .node:hover rect, .node:focus rect, .node.sel rect { stroke: var(--line); stroke-width: 2; }
  .node:hover text, .node.sel text { fill: var(--line); }
  .wire { fill: none; stroke: var(--rule); stroke-width: 1.2; }
  .wire.hot { stroke: var(--line); stroke-width: 1.6; }
  .hub rect { fill: var(--ink); } .hub text { fill: var(--paper); font-family: var(--font-display); font-weight: 700; font-size: 15px; letter-spacing: .04em; text-transform: uppercase; }
</style>
