---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { io } from '../data/io';
import { allWork, media, CAT } from '../lib/data';
import { writing } from '../lib/writing';

const work = await allWork();
const flagship = work.filter((w) => w.data.tier === 1);
const lead = flagship.find((w) => w.id === 'blockforge')!;
const four = flagship.filter((w) => w !== lead);
const rest = work.filter((w) => w.data.tier > 1);
const posts = (await writing()).slice(0, 4);
const num = (w: typeof work[number]) => String(work.indexOf(w) + 1).padStart(2, '0');
const short: Record<string, string> = { 'pos-store-management': 'POS' };
const conv = [
  { s: 'blockforge', src: 'a world script', out: 'a voxel world, then a film' },
  { s: 'h-system', src: 'a wire', out: 'an agent driving an applet' },
  { s: 'pos-store-management', src: 'a sale', out: 'a ledger in USD and LBP' },
  { s: 'anythyng', src: 'a sentence', out: 'an app on your phone' },
  { s: 'uipen', src: 'a pin on a page', out: 'the right line of code' },
];
const leadThumb = media('blockforge').turntables.find((t) => t.src.includes('train'));
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<Base nav="" sheet="Index sheet" dwg="00">
  <div class="hero">
    <div>
      <p class="label" style="margin-bottom:18px">Engineer and mathematician · {site.location}</p>
      <h1>{site.thesis}</h1>
      <p class="lede">{site.lede}</p>
      <nav class="conv" aria-label="What each flagship compiles">
        {conv.map((c) => (
          <a href={`/work/${c.s}`}><span class="src">{c.src}</span><span class="arrow" aria-hidden="true">→</span><span>{c.out}</span><span class="who">{short[c.s] ?? work.find((w) => w.id === c.s)?.data.title}</span></a>
        ))}
      </nav>
      <div class="cta"><a class="btn" href="/work">See the work</a><a class="btn ghost" href={site.cvPdf}>Download CV</a></div>
    </div>
    <figure class="fig">
      <div class="frame">
        <img src="/media/blockforge/hero.webp" alt={media('blockforge').heroAlt ?? 'A BlockForge render'} width="1600" height="900" fetchpriority="high">
        <span class="balloon" style="left:63%;top:49%">1</span>
        <span class="balloon" style="left:48%;top:86%">2</span>
      </div>
      <div class="dim"><span>1600 × 900 px · engine render</span></div>
      <figcaption><b>FIG. 0</b><span>BlockForge output. <b>1</b> the arches and <b>2</b> the river come from the same world source.</span></figcaption>
      <div class="notes"><span class="label">General notes</span><ol>
        <li>3D images are BlockForge output only. No stock renders, no decoration.</li>
        <li>Screens are captured from the running apps with demo data.</li>
        <li>Counts in the title blocks come from the repositories; self-reported figures say so.</li>
      </ol></div>
    </figure>
  </div>

  <section class="sheet-section" aria-labelledby="s1">
    <div class="sechead"><span class="label">Sheet 01 · Flagships</span><h2 id="s1">Five systems, each with its input and its output</h2><span class="label">5 of {work.length}</span></div>

    <article class="item flag-main">
      <figure class="fig">
        {leadThumb ? (
          <div class="frame"><img src={leadThumb.poster} alt={leadThumb.alt} width="1280" height="720" loading="lazy">
            <span class="balloon" style="left:18%;top:62%">1</span><span class="balloon" style="left:72%;top:28%">2</span></div>
        ) : null}
        <figcaption><b>FIG. 1</b><span>Turntable render from the engine. <b>1</b> locomotive, <b>2</b> carriages, both compiled objects.</span></figcaption>
      </figure>
      <div>
        <div class="no"><span class="label">{num(lead)} · {lead.data.categories.slice(0, 3).map((c) => CAT[c]).join(', ')}</span><span class="label">{lead.data.period}</span></div>
        <h3 style="font-size:30px;font-variation-settings:'wdth' 118"><a href="/work/blockforge">{lead.data.title}</a></h3>
        <p class="hook" style="font-size:18px">{lead.data.hook}</p>
        <dl class="io">
          <div><dt>IN</dt><dd>{io.blockforge.in}</dd></div>
          <div><dt>OUT</dt><dd class="plain">{io.blockforge.out}</dd></div>
          {io.blockforge.see && <div><dt>SEE</dt><dd class="plain">{io.blockforge.see}</dd></div>}
        </dl>
        <p style="margin-top:16px"><a class="link" href="/work/blockforge">Read the case study</a></p>
      </div>
    </article>

    <div class="flags">
      {four.map((w) => {
        const m = media(w.id);
        return (
          <article class="item">
            <div class="no"><span class="label">{num(w)} · {CAT[w.data.categories[0]]}</span><span class="label">{w.data.period.split(' to ')[0]}</span></div>
            {m.hero && <figure class="fig"><a class="frame ratio" href={`/work/${w.id}`} style="display:block"><img src={m.hero} alt={m.heroAlt ?? w.data.title} loading="lazy"></a></figure>}
            <h3><a href={`/work/${w.id}`}>{w.data.title === 'Store POS and management ecosystem' ? 'Store POS' : w.data.title}</a></h3>
            <p class="hook">{w.data.hook}</p>
            {io[w.id] && <dl class="io"><div><dt>IN</dt><dd>{io[w.id].in}</dd></div><div><dt>OUT</dt><dd class="plain">{io[w.id].out}</dd></div></dl>}
          </article>
        );
      })}
    </div>
  </section>

  <section class="sheet-section" aria-labelledby="s2">
    <div class="sechead"><span class="label">Sheet 02 · Parts list</span><h2 id="s2">Everything else, by what it turns into what</h2><span class="label">{rest.length} of {work.length}</span></div>
    <table class="parts">
      <thead><tr><th>No.</th><th>Project</th><th>Input → output</th><th>Period</th></tr></thead>
      <tbody>
        {rest.map((w) => (
          <tr>
            <td class="n">{num(w)}</td>
            <td class="name"><a href={`/work/${w.id}`}>{w.data.title}</a></td>
            <td class="io2">{io[w.id] ? <>{io[w.id].in}<i>→</i>{io[w.id].out.replace(/\.$/, '')}</> : w.data.hook}</td>
            <td class="when">{w.data.period}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="sheet-section" aria-labelledby="s3">
    <div class="sechead"><span class="label">Sheet 03 · Writing</span><h2 id="s3">Notes from the blog</h2><a class="label" href={site.blog} style="color:var(--line)">blog.housamkak.com ↗</a></div>
    <table class="parts">
      <tbody>
        {posts.map((p) => (
          <tr>
            <td class="when" style="width:110px">{fmt(p.date)}</td>
            <td class="name"><a href={p.url}>{p.title}</a></td>
            <td style="color:var(--muted);font-size:15.5px">{p.description}</td>
            <td class="when">{p.kind}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>
