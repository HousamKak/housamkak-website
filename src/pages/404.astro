---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" sheet="Missing sheet" dwg="404">
  <header class="cs-head" style="border:0;padding-block:72px">
    <div><p class="label">Error 404</p></div>
    <div>
      <h1>This sheet is not in the set.</h1>
      <p class="lede">It may have moved when the site was rebuilt. Try the <a href="/work" style="color:var(--line)">parts list</a> or the <a href="/" style="color:var(--line)">index sheet</a>.</p>
    </div>
  </header>
</Base>
