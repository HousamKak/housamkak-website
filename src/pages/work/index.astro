---
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { allWork, CAT } from '../../lib/data';

const work = await allWork();
const cats = Object.keys(CAT).filter((c) => work.some((w) => w.data.categories.includes(c)));
const groups = [
  { t: 1, title: 'Flagship systems' },
  { t: 2, title: 'Case studies' },
  { t: 3, title: 'Lab' },
];
const num = (w: typeof work[number]) => String(work.indexOf(w) + 1).padStart(2, '0');
---
<Base title="Work" nav="work" sheet="Parts list" dwg="01" description="Every system, tool and experiment Housam Kak has built, listed by what it turns into what.">
  <header class="cs-head">
    <div><p class="label">Parts list</p></div>
    <div>
      <h1>Work</h1>
      <p class="lede">Every project, listed by its input and what it turns that input into. Flagships and case studies have full sheets; lab entries are short notes.</p>
    </div>
  </header>
  <section class="sheet-section" style="padding-top:28px">
    <div class="filters" id="filters" role="group" aria-label="Filter by field">
      <button type="button" data-c="all" aria-pressed="true">All</button>
      {cats.map((c) => <button type="button" data-c={c} aria-pressed="false">{CAT[c]}</button>)}
    </div>
    {groups.map((g) => (
      <div class="pgroup" data-group>
        <h2 class="pgroup-h">{g.title}</h2>
        <ProjectGrid items={work.filter((w) => w.data.tier === g.t)} number={num} filterable />
      </div>
    ))}
  </section>
  <script>
    const f = document.getElementById('filters')!;
    f.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button'); if (!b) return;
      const c = b.dataset.c!;
      f.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-cats]').forEach((r) => { r.hidden = c !== 'all' && !r.dataset.cats!.split(' ').includes(c); });
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((t) => { t.hidden = !t.querySelector('[data-cats]:not([hidden])'); });
    });
  </script>
</Base>
