---
import Base from '../layouts/Base.astro';
import { allWork, CAT, tierLabel } from '../lib/data';
const work = await allWork();
const data = work.map((w) => ({ s: w.id, n: w.data.title, t: w.data.tier, c: w.data.categories, h: w.data.hook }));
const DCOL: Record<string, string> = {
  'ai-agents': '#2F8F7E', 'graphics-3d': '#C46A34', 'business-software': '#3F6FA8', 'engineering-hardware': '#8A6D3B',
  'research-simulation': '#7B5EA7', games: '#B8434F', 'dev-tools': '#4E7D4A', infrastructure: '#5D6B73', 'media-creative': '#C2913A',
  'consumer-apps': '#3E9BB5', startup: '#9A5B7A', enterprise: '#2E3F52', mobile: '#3E9BB5',
};
const districts = [...new Set(work.map((w) => w.data.categories[0]).filter(Boolean))];
---
<Base title="Explore in 3D" nav="3d" description="Every project Housam Kak has built, as a voxel city. Optional 3D mode with a real BlockForge export.">
  <div class="wrap"><div class="inner">
    <header class="cs-head">
      <div class="kicker">Explore in 3D · optional</div>
      <h1>A city of things I have built.</h1>
      <p class="lede">Each building is a project: height is how much it matters, colour is its field. The locomotive is a real BlockForge export. Drag to orbit, click a building to read about it.</p>
    </header>
    <div class="city">
      <div class="stage" id="stage"><div class="load" id="vload">Building the city…</div><div class="hint">drag · scroll · click</div></div>
      <aside class="plot" id="plot" aria-live="polite">
        <div class="kicker" id="pk">Selected building</div>
        <h2 id="ph">Pick a building</h2>
        <p id="pp">Or use the list below. The 3D is a mode, never the only way in.</p>
        <a id="pa" href="/work" class="links">Open the work index →</a>
        <div class="districts">{districts.map((c) => <div><i style={`background:${DCOL[c] ?? '#777'}`}></i>{CAT[c] ?? c}</div>)}</div>
      </aside>
    </div>
    <div class="plainlist" id="plain">
      {work.map((w) => <button type="button" data-s={w.id}><b>{tierLabel(w.data.tier)}</b>{w.data.title}</button>)}
    </div>
  </div></div>
  <script type="application/json" id="city-data" set:html={JSON.stringify({ data, DCOL })} />
</Base>

<style>
  .city { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 18px; padding-block: 10px 24px; }
  .stage { position: relative; height: min(68vh, 620px); min-height: 380px; border-radius: 6px; overflow: hidden; background: #DCDDD3; border: 1px solid var(--line); }
  .stage :global(canvas) { display: block; width: 100%; height: 100%; touch-action: none; }
  .hint { position: absolute; left: 12px; bottom: 10px; font-family: var(--f-mono); font-size: 12px; color: #4F5852; background: rgba(233,234,227,.85); padding: 4px 8px; border-radius: 3px; }
  .stage :global(.tip) { position: absolute; pointer-events: none; font-family: var(--f-mono); font-size: 12px; background: #1C211E; color: #F0EFE6; padding: 4px 8px; border-radius: 3px; transform: translate(12px, -28px); white-space: nowrap; }
  .load { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--f-mono); font-size: 13px; color: #4F5852; }
  .plot { border: 1px solid var(--line); border-radius: 6px; background: var(--panel); padding: 16px; display: grid; gap: 9px; align-content: start; }
  .plot h2 { margin: 0; font-size: 24px; font-weight: 800; }
  .plot p { margin: 0; color: var(--muted); font-size: 14px; }
  .plot .links { font-family: var(--f-mono); font-size: 13px; color: var(--teal); }
  .districts { display: grid; gap: 6px; margin-top: 8px; }
  .districts div { display: flex; gap: 8px; align-items: center; font-family: var(--f-mono); font-size: 12px; color: var(--muted); }
  .districts i { width: 12px; height: 12px; border-radius: 2px; display: inline-block; }
  .plainlist { columns: 3 220px; gap: 24px; padding-block: 6px 64px; font-size: 14px; }
  .plainlist button { all: unset; cursor: pointer; display: block; padding: 3px 0; break-inside: avoid; }
  .plainlist button:hover, .plainlist button:focus-visible { color: var(--teal); text-decoration: underline; }
  .plainlist b { font-family: var(--f-mono); font-weight: 500; font-size: 11px; color: var(--muted); margin-right: 6px; }
  @media (max-width: 900px) { .city { grid-template-columns: 1fr; } }
</style>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';

  type P = { s: string; n: string; t: number; c: string[]; h: string };
  const { data: PR, DCOL } = JSON.parse(document.getElementById('city-data')!.textContent!) as { data: P[]; DCOL: Record<string, string> };
  const tl = (t: number) => (t === 1 ? 'Flagship' : t === 2 ? 'Case study' : 'Lab');
  const stage = document.getElementById('stage')!;
  const $ = (id: string) => document.getElementById(id)!;
  const card = (p: P) => { $('pk').textContent = tl(p.t); $('ph').textContent = p.n; $('pp').textContent = p.h; ($('pa') as HTMLAnchorElement).href = `/work/${p.s}`; $('pa').textContent = 'Read the project →'; };

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let renderer: THREE.WebGLRenderer;
  try { renderer = new THREE.WebGLRenderer({ antialias: true }); }
  catch { $('vload').textContent = 'Your browser could not start 3D. The list below has every project.'; throw new Error('no webgl'); }
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  stage.prepend(renderer.domElement);
  const scene = new THREE.Scene(); scene.background = new THREE.Color('#DCDDD3'); scene.fog = new THREE.Fog('#DCDDD3', 90, 190);
  const cam = new THREE.PerspectiveCamera(35, 1, 0.5, 500); cam.position.set(58, 52, 66);
  const ctl = new OrbitControls(cam, renderer.domElement); ctl.enableDamping = true; ctl.target.set(0, 4, 0);
  ctl.maxPolarAngle = Math.PI * 0.47; ctl.minDistance = 30; ctl.maxDistance = 150; ctl.autoRotate = !reduce; ctl.autoRotateSpeed = 0.5;
  scene.add(new THREE.HemisphereLight('#FFFFFF', '#8A8676', 1.1));
  const sun = new THREE.DirectionalLight('#FFF1DA', 2.0); sun.position.set(40, 70, 25); sun.castShadow = true;
  sun.shadow.mapSize.set(2048, 2048); Object.assign(sun.shadow.camera, { left: -60, right: 60, top: 60, bottom: -60, near: 1, far: 200 }); scene.add(sun);
  const ground = new THREE.Mesh(new THREE.BoxGeometry(96, 1, 76), new THREE.MeshLambertMaterial({ color: '#C9C6B6' }));
  ground.position.y = -0.5; ground.receiveShadow = true; scene.add(ground);

  let seed = 7; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
  const order = [...PR].sort((a, b) => a.t - b.t);
  const slots: [number, number][] = []; for (let gz = -3; gz <= 2; gz++) for (let gx = -4; gx <= 4; gx++) slots.push([gx, gz]);
  slots.sort((a, b) => Math.hypot(a[0], a[1] * 1.3) - Math.hypot(b[0], b[1] * 1.3));
  const vox: { x: number; y: number; z: number; c: THREE.Color; idx: number }[] = [];
  const cream = new THREE.Color('#F3EBD2');
  order.forEach((p, i) => {
    const slot = slots[i]; if (!slot) return;
    const [gx, gz] = slot; const ox = gx * 10, oz = gz * 10;
    const base = new THREE.Color(DCOL[p.c[0]] ?? '#777777');
    const w = p.t === 1 ? 6 : p.t === 2 ? 5 : 4, d = w;
    const hgt = p.t === 1 ? 14 + Math.floor(rnd() * 6) : p.t === 2 ? 7 + Math.floor(rnd() * 4) : 3 + Math.floor(rnd() * 3);
    const pidx = PR.indexOf(p);
    for (let y = 0; y < hgt; y++) {
      const inset = p.t === 1 && y > hgt * 0.85 ? 2 : y > hgt * 0.66 ? 1 : 0;
      for (let x = inset; x < w - inset; x++) for (let z = inset; z < d - inset; z++) {
        const shell = x === inset || z === inset || x === w - 1 - inset || z === d - 1 - inset || y === hgt - 1;
        if (!shell) continue;
        const win = y > 0 && y < hgt - 1 && y % 2 === 1 && (x + z) % 2 === 1;
        const c = base.clone(); if (win) c.lerp(cream, 0.45); else c.offsetHSL(0, 0, (rnd() - 0.5) * 0.06);
        vox.push({ x: ox - w / 2 + x + 0.5, y: y + 0.5, z: oz - d / 2 + z + 0.5, c, idx: pidx });
      }
    }
    const pad = new THREE.Mesh(new THREE.BoxGeometry(w + 2, 0.2, d + 2), new THREE.MeshLambertMaterial({ color: '#B9B5A3' }));
    pad.position.set(ox, 0.1, oz); pad.receiveShadow = true; scene.add(pad);
  });
  const mesh = new THREE.InstancedMesh(new THREE.BoxGeometry(0.96, 0.96, 0.96), new THREE.MeshLambertMaterial(), vox.length);
  mesh.castShadow = mesh.receiveShadow = true;
  const m4 = new THREE.Matrix4();
  vox.forEach((v, i) => { m4.makeTranslation(v.x, v.y, v.z); mesh.setMatrixAt(i, m4); mesh.setColorAt(i, v.c); });
  scene.add(mesh);

  new GLTFLoader().load('/img/train.glb', (g) => {
    const o = g.scene; const size = new THREE.Box3().setFromObject(o).getSize(new THREE.Vector3());
    if (size.z > size.x) o.rotation.y = Math.PI / 2;
    o.scale.setScalar(26 / Math.max(size.x, size.z));
    const b2 = new THREE.Box3().setFromObject(o), c2 = b2.getCenter(new THREE.Vector3());
    o.position.set(-c2.x, -b2.min.y + 0.3, -c2.z + 33);
    o.traverse((n) => { if ((n as THREE.Mesh).isMesh) { n.castShadow = n.receiveShadow = true; } }); scene.add(o);
    const rail = new THREE.Mesh(new THREE.BoxGeometry(84, 0.3, 4), new THREE.MeshLambertMaterial({ color: '#8F8A78' }));
    rail.position.set(0, 0.15, 33); rail.receiveShadow = true; scene.add(rail);
  });

  const ray = new THREE.Raycaster(), mp = new THREE.Vector2(); let hover = -1, sel = -1;
  const tip = document.createElement('div'); tip.className = 'tip'; tip.hidden = true; stage.appendChild(tip);
  const white = new THREE.Color('#FFFFFF');
  function paint(idx: number, mix: number) { vox.forEach((v, i) => { if (v.idx === idx) { const c = v.c.clone(); if (mix) c.lerp(white, mix); mesh.setColorAt(i, c); } }); mesh.instanceColor!.needsUpdate = true; }
  function pick(e: PointerEvent) { const r = renderer.domElement.getBoundingClientRect(); mp.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1); ray.setFromCamera(mp, cam); const h = ray.intersectObject(mesh); return h.length ? vox[h[0].instanceId!].idx : -1; }
  const el = renderer.domElement;
  el.addEventListener('pointermove', (e) => {
    const idx = pick(e);
    if (idx !== hover) { if (hover >= 0 && hover !== sel) paint(hover, 0); hover = idx; if (idx >= 0 && idx !== sel) paint(idx, 0.25); }
    if (idx >= 0) { const r = stage.getBoundingClientRect(); tip.hidden = false; tip.textContent = PR[idx].n; tip.style.left = `${e.clientX - r.left}px`; tip.style.top = `${e.clientY - r.top}px`; el.style.cursor = 'pointer'; }
    else { tip.hidden = true; el.style.cursor = 'grab'; }
  });
  el.addEventListener('pointerleave', () => (tip.hidden = true));
  let down: [number, number] | null = null;
  el.addEventListener('pointerdown', (e) => (down = [e.clientX, e.clientY]));
  el.addEventListener('pointerup', (e) => { if (!down || Math.hypot(e.clientX - down[0], e.clientY - down[1]) > 5) return; const idx = pick(e); if (idx >= 0) choose(idx); });
  function choose(idx: number) { if (sel >= 0) paint(sel, 0); sel = idx; paint(idx, 0.45); card(PR[idx]); ctl.autoRotate = false; }
  $('plain').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button'); if (!b) return;
    choose(PR.findIndex((p) => p.s === b.dataset.s)); stage.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
  });
  function size() { const w = stage.clientWidth, h = stage.clientHeight; renderer.setSize(w, h, false); cam.aspect = w / h; cam.updateProjectionMatrix(); }
  new ResizeObserver(size).observe(stage); size();
  $('vload').remove();
  let visible = true;
  new IntersectionObserver(([en]) => (visible = en.isIntersecting)).observe(stage);
  renderer.setAnimationLoop(() => { if (!visible) return; ctl.update(); renderer.render(scene, cam); });
</script>
