---
// The 3D card portfolio: the original housamkak.com experience (card ring, particle field, teal on near-black),
// rebuilt with current content and real screenshots. Fixed: tappable navigation on phones, no loading screen,
// zoom allowed, keyboard and reduced-motion support, deep links per card, no fake contact form.
import { site } from '../data/site';
import { io } from '../data/io';
import { allWork, media } from '../lib/data';

const work = await allWork();
const flag = ['blockforge', 'h-system', 'pos-store-management', 'anythyng', 'uipen'].map((s) => work.find((w) => w.id === s)!).filter(Boolean);
const cases = work.filter((w) => w.data.tier === 2);
const short: Record<string, string> = { 'pos-store-management': 'Store POS', 'h-system': 'H' };
const cards = [
  { id: 'home', label: 'Home' },
  { id: 'now', label: 'Experience' },
  ...flag.map((w) => ({ id: w.id, label: short[w.id] ?? w.data.title })),
  { id: 'more', label: 'More work' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>3D portfolio · {site.name}</title>
  <meta name="description" content={`${site.name}'s portfolio as a ring of cards in 3D: ${site.thesis}`}>
  <link rel="canonical" href={`${site.url}/3d`}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:title" content={`3D portfolio · ${site.name}`}>
  <meta property="og:image" content={`${site.url}/og/default.png`}>
  <meta name="theme-color" content="#0A1114">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
</head>
<body>
  <a class="skip" href="/work">Skip the 3D view: open the work index</a>
  <div id="three" aria-hidden="true"></div>

  <header class="bar">
    <a class="brand" href="/">Housam <span>Kak</span></a>
    <a class="flat" href="/">Standard site ↗</a>
  </header>

  <main class="stage" id="stage" aria-roledescription="carousel" aria-label="Portfolio cards">
    <section class="card" id="home" data-i="0" aria-label="Home">
      <div class="card-head"><h1 class="title">Hi, I'm <span class="accent">Housam Kak</span></h1></div>
      <div class="card-body center">
        <img class="photo" src="/img/profile.webp" alt="Portrait of Housam Kak" width="480" height="720">
        <p class="role">Engineer and mathematician · {site.location}</p>
        <p class="thesis">{site.thesis}</p>
        <p class="muted">{site.lede}</p>
        <div class="btns">
          <a class="btn" href="/work">See every project</a>
          <a class="btn ghost" href={site.cvPdf}>Download CV</a>
        </div>
        <p class="hint">Swipe, use the arrows, or pick a card below.</p>
      </div>
    </section>

    <section class="card" id="now" data-i="1" aria-label="Experience">
      <div class="card-head"><h2 class="title">Experience</h2></div>
      <div class="card-body">
        <div class="exp">
          <h3>Product Lead, AI Systems Pilot</h3>
          <p class="meta">A global investment firm · 2024 to present</p>
          <ul>
            <li>Lead a pilot AI systems team: product direction and senior software for a conversational platform that connects staff to company data.</li>
            <li>MCP integrations, graph access, Azure Cosmos DB and Azure AI Search, on distributed microservices.</li>
          </ul>
        </div>
        <div class="exp">
          <h3>Consultant, OmniVista Solutions</h3>
          <p class="meta">Financial technology consultancy, Dubai · Apr 2023 to present</p>
          <ul>
            <li>Requirements, architecture and delivery for investment-firm clients: an analyst recommendation portal, data integration services and Power BI exposure reporting.</li>
            <li>Portfolio application load time cut by about 70%; client support operations across 2,500+ tickets.</li>
          </ul>
        </div>
        <div class="exp">
          <h3>Independent systems</h3>
          <p class="meta">2026</p>
          <ul><li>Five flagship systems and two dozen tools, each on the next cards.</li></ul>
        </div>
      </div>
    </section>

    {flag.map((w, k) => {
      const m = media(w.id);
      const x = io[w.id];
      return (
        <section class="card" id={w.id} data-i={k + 2} aria-label={w.data.title}>
          <div class="card-head"><p class="kicker">Flagship {k + 1} of 5</p><h2 class="title">{w.data.title}</h2></div>
          <div class="card-body">
            {m.hero && <img class="shot" src={m.hero} alt={m.heroAlt ?? w.data.title} loading="lazy">}
            <p class="hook">{w.data.hook}</p>
            {x && <dl class="io"><div><dt>In</dt><dd class="mono">{x.in}</dd></div><div><dt>Out</dt><dd>{x.out}</dd></div></dl>}
            <p class="muted small">{w.data.role} · {w.data.period}</p>
            <div class="btns"><a class="btn" href={`/work/${w.id}`}>Read the case study</a>{w.data.links.live && <a class="btn ghost" href={w.data.links.live}>Live site ↗</a>}</div>
          </div>
        </section>
      );
    })}

    <section class="card" id="more" data-i={flag.length + 2} aria-label="More work">
      <div class="card-head"><h2 class="title">More work</h2></div>
      <div class="card-body">
        <ul class="list">
          {cases.map((w) => <li><a href={`/work/${w.id}`}><b>{w.data.title}</b><span>{w.data.hook}</span></a></li>)}
        </ul>
        <div class="btns"><a class="btn ghost" href="/work">All {work.length} projects</a></div>
      </div>
    </section>

    <section class="card" id="skills" data-i={flag.length + 3} aria-label="Skills and education">
      <div class="card-head"><h2 class="title">Skills and education</h2></div>
      <div class="card-body">
        <h3 class="sub">AI and architecture</h3>
        <p class="tags"><span>Conversational AI</span><span>MCP</span><span>Agent orchestration</span><span>Graph and search</span><span>Microservices</span></p>
        <h3 class="sub">Engineering</h3>
        <p class="tags"><span>TypeScript</span><span>Python</span><span>C#</span><span>C++</span><span>SQL</span><span>Kotlin</span><span>React</span><span>Node.js</span><span>Three.js</span></p>
        <h3 class="sub">Cloud and data</h3>
        <p class="tags"><span>Azure</span><span>AWS</span><span>Cloudflare</span><span>OpenTofu</span><span>PostgreSQL</span><span>SQLite</span><span>CI/CD</span></p>
        <h3 class="sub">Education</h3>
        <p>B.E. Mechanical Engineering, major in Mathematics, American University of Beirut (2018 to 2022). Mastercard Foundation Scholar.</p>
        <p class="muted small">Graduation project: an autonomous miniature racing car with camera-based lane perception and pure-pursuit control.</p>
      </div>
    </section>

    <section class="card" id="contact" data-i={flag.length + 4} aria-label="Contact">
      <div class="card-head"><h2 class="title">Contact</h2></div>
      <div class="card-body center">
        <p class="muted">The fastest way to reach me is email.</p>
        <p class="email mono">{site.email} <button class="copy" type="button" data-copy={site.email}>Copy</button></p>
        <div class="links">
          <a href={site.github}>GitHub</a><a href={site.linkedin}>LinkedIn</a><a href={site.blog}>Blog</a><a href={site.blockforge}>BlockForge</a><a href={site.cvPdf}>CV (PDF)</a>
        </div>
        <p class="muted small">Based in {site.location}. Open to remote and on-site work.</p>
      </div>
    </section>
  </main>

  <nav class="dock" aria-label="Cards">
    <button class="arrow" type="button" data-step="-1" aria-label="Previous card">←</button>
    <div class="menu" id="menu">
      {cards.map((c, i) => <button type="button" data-go={i} aria-controls={c.id}>{c.label}</button>)}
    </div>
    <button class="arrow" type="button" data-step="1" aria-label="Next card">→</button>
  </nav>
  <p class="counter" id="counter" aria-live="polite"></p>
</body>
</html>

<style is:global>
  :root { --bg: #0A1114; --panel: rgba(12, 26, 30, .82); --ink: #E6F4F2; --muted: #9DB8B4; --teal: #3EE6D6; --teal-2: #1FB5A8; --line: rgba(62, 230, 214, .22); color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 16px/1.6 Montserrat, system-ui, sans-serif; overflow: hidden; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; }
  .skip { position: absolute; left: -9999px; z-index: 50; }
  .skip:focus { left: 16px; top: 12px; background: var(--teal); color: #04201d; padding: 8px 12px; }
  .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }
  #three { position: fixed; inset: 0; z-index: 0; background: radial-gradient(ellipse at 50% 40%, #0f2227, var(--bg) 70%); }
  #three canvas { display: block; }

  .bar { position: fixed; inset: 0 0 auto; z-index: 30; display: flex; justify-content: space-between; align-items: center; padding: max(14px, env(safe-area-inset-top)) max(18px, env(safe-area-inset-right)) 10px max(18px, env(safe-area-inset-left)); }
  .brand { font-weight: 700; font-size: 18px; letter-spacing: .02em; text-decoration: none; }
  .brand span { color: var(--teal); }
  .flat { font-size: 13px; text-decoration: none; color: var(--muted); border: 1px solid var(--line); border-radius: 99px; padding: 6px 12px; background: rgba(10, 17, 20, .6); }
  .flat:hover { color: var(--teal); border-color: var(--teal); }

  .stage { position: fixed; inset: 0; z-index: 10; perspective: 1200px; display: grid; place-items: center; touch-action: pan-y; }
  .card { position: absolute; width: min(440px, calc(100vw - 32px)); height: min(640px, calc(100dvh - 170px)); display: flex; flex-direction: column;
    background: var(--panel); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--line); border-radius: 18px;
    box-shadow: 0 0 24px rgba(62, 230, 214, .08); transition: transform .7s cubic-bezier(.2, .7, .2, 1), opacity .5s; will-change: transform; margin-top: 10px; }
  .card.active { border-color: rgba(62, 230, 214, .5); box-shadow: 0 0 40px rgba(62, 230, 214, .16); }
  .card:not(.active) { pointer-events: none; }
  .card-head { padding: 22px 26px 12px; border-bottom: 1px solid var(--line); }
  .kicker { margin: 0 0 4px; font: 500 11.5px/1.3 "JetBrains Mono", monospace; letter-spacing: .08em; text-transform: uppercase; color: var(--teal); }
  .title { margin: 0; font-size: 24px; font-weight: 700; line-height: 1.2; }
  .accent { color: var(--teal); }
  .card-body { padding: 18px 26px 24px; overflow-y: auto; flex: 1; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--teal-2) transparent; }
  .card-body.center { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .card-body p { margin: 0 0 12px; }
  .photo { width: 132px; height: 132px; object-fit: cover; object-position: 50% 18%; border-radius: 50%; border: 2px solid var(--teal); margin: 4px 0 14px; }
  .role { font-weight: 600; color: var(--teal); font-size: 14px; letter-spacing: .02em; }
  .thesis { font-size: 21px; font-weight: 700; line-height: 1.3; }
  .muted { color: var(--muted); }
  .small { font-size: 13.5px; }
  .hint { margin-top: auto !important; font-size: 12.5px; color: var(--muted); padding-top: 10px; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .center .btns { justify-content: center; }
  .btn { display: inline-block; text-decoration: none; font-weight: 600; font-size: 14px; padding: 10px 16px; border-radius: 99px; background: var(--teal); color: #04201d; border: 1px solid var(--teal); }
  .btn:hover { background: #7af0e5; }
  .btn.ghost { background: transparent; color: var(--teal); }
  .btn.ghost:hover { background: rgba(62, 230, 214, .1); }
  .exp { padding-bottom: 14px; margin-bottom: 14px; border-bottom: 1px solid var(--line); }
  .exp:last-child { border: 0; margin: 0; }
  .exp h3 { margin: 0; font-size: 17px; }
  .meta { font-size: 13px; color: var(--teal); margin: 2px 0 8px !important; }
  .exp ul, .list { margin: 0; padding-left: 18px; }
  .exp li { margin-bottom: 6px; font-size: 14.5px; }
  .shot { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: left top; border-radius: 10px; border: 1px solid var(--line); margin-bottom: 14px; background: #000; }
  .hook { font-size: 17px; font-weight: 600; line-height: 1.4; }
  .io { margin: 0 0 12px; border-top: 1px solid var(--line); font-size: 14px; }
  .io div { display: grid; grid-template-columns: 40px 1fr; gap: 8px; padding: 7px 0; border-bottom: 1px solid var(--line); }
  .io dt { font: 500 11px/1.7 "JetBrains Mono", monospace; text-transform: uppercase; letter-spacing: .08em; color: var(--teal); }
  .io dd { margin: 0; overflow-wrap: anywhere; }
  .io dd.mono { font-size: 13px; }
  .list { list-style: none; padding: 0; margin-bottom: 14px; }
  .list li { border-bottom: 1px solid var(--line); }
  .list a { display: grid; gap: 2px; padding: 9px 0; text-decoration: none; }
  .list b { font-size: 15px; }
  .list span { font-size: 13.5px; color: var(--muted); }
  .list a:hover b { color: var(--teal); }
  .sub { margin: 12px 0 6px; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--teal); }
  .sub:first-child { margin-top: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags span { font-size: 12.5px; border: 1px solid var(--line); border-radius: 99px; padding: 3px 10px; }
  .email { font-size: 15px; margin-top: 8px !important; }
  .copy { font: 600 12px Montserrat, sans-serif; color: var(--teal); background: none; border: 1px solid var(--teal); border-radius: 99px; padding: 3px 10px; margin-left: 6px; cursor: pointer; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 10px 0 16px; }
  .links a { text-decoration: none; font-size: 14px; border: 1px solid var(--line); border-radius: 99px; padding: 7px 14px; }
  .links a:hover { border-color: var(--teal); color: var(--teal); }

  .dock { position: fixed; z-index: 30; left: 50%; transform: translateX(-50%); bottom: max(16px, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 8px; max-width: calc(100vw - 24px);
    background: rgba(10, 17, 20, .75); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border: 1px solid var(--line); border-radius: 99px; padding: 6px; }
  .menu { display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; scroll-behavior: smooth; }
  .menu::-webkit-scrollbar { display: none; }
  .dock button { font: 500 13px Montserrat, sans-serif; color: var(--muted); background: none; border: 0; border-radius: 99px; padding: 9px 12px; cursor: pointer; white-space: nowrap; min-height: 40px; }
  .dock button:hover { color: var(--ink); }
  .dock button[aria-current="true"] { background: var(--teal); color: #04201d; font-weight: 600; }
  .dock .arrow { font-size: 16px; color: var(--teal); flex: none; width: 40px; }
  .counter { position: fixed; z-index: 30; right: max(18px, env(safe-area-inset-right)); bottom: 80px; margin: 0; font: 500 12px "JetBrains Mono", monospace; color: var(--muted); }
  @media (max-width: 640px) {
    .card { height: calc(100dvh - 150px); }
    .card-head { padding: 18px 20px 10px; }
    .card-body { padding: 14px 20px 20px; }
    .title { font-size: 21px; }
    .counter { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .card { transition: opacity .2s; } }
</style>

<script>
  import * as THREE from 'three';

  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const menu = [...document.querySelectorAll<HTMLButtonElement>('[data-go]')];
  const counter = document.getElementById('counter')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let active = Math.max(0, cards.findIndex((c) => '#' + c.id === location.hash));
  let ringTarget = 0;

  function spacing() {
    const w = innerWidth, cw = Math.min(440, w - 32);
    return w < 700 ? cw + 40 : Math.min(620, Math.max(cw + 80, w * 0.36));
  }
  function layout() {
    const n = cards.length, gap = spacing();
    cards.forEach((c, i) => {
      let r = i - active;
      if (r < -Math.floor(n / 2)) r += n; else if (r > Math.floor(n / 2)) r -= n;
      const a = Math.abs(r);
      const x = r === 0 ? 0 : Math.sign(r) * (gap + (a - 1) * gap * 0.55);
      const z = -320 * a, y = -40 * a, ry = r === 0 ? 0 : -Math.sign(r) * Math.min(36, 22 + a * 6);
      c.style.transform = `translate3d(${x}px, ${y}px, ${z}px) rotateY(${ry}deg)`;
      c.style.opacity = a === 0 ? '1' : a === 1 ? '0.42' : '0';
      c.style.zIndex = String(20 - a);
      c.classList.toggle('active', a === 0);
      c.setAttribute('aria-hidden', String(a !== 0));
      c.inert = a !== 0;
    });
    menu.forEach((b, i) => b.setAttribute('aria-current', String(i === active)));
    menu[active]?.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduce ? 'auto' : 'smooth' });
    counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
    ringTarget = -(active / cards.length) * Math.PI * 2;
    history.replaceState(null, '', '#' + cards[active].id);
  }
  function go(i: number) { active = (i + cards.length) % cards.length; layout(); }

  document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => go(active + Number(b.dataset.step))));
  menu.forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.go))));
  addEventListener('keydown', (e) => {
    if ((e.target as HTMLElement).closest('input, textarea')) return;
    if (e.key === 'ArrowRight') go(active + 1);
    if (e.key === 'ArrowLeft') go(active - 1);
  });
  // Wheel: one card per gesture, unless the wheel is scrolling inside a card that can still scroll.
  let wheelLock = 0;
  addEventListener('wheel', (e) => {
    const body = (e.target as HTMLElement).closest<HTMLElement>('.card-body');
    if (body) {
      const atTop = body.scrollTop <= 0, atEnd = body.scrollTop + body.clientHeight >= body.scrollHeight - 1;
      if ((e.deltaY > 0 && !atEnd) || (e.deltaY < 0 && !atTop)) return;
    }
    const now = Date.now();
    if (now < wheelLock || Math.abs(e.deltaY) < 12) return;
    wheelLock = now + 650;
    go(active + (e.deltaY > 0 ? 1 : -1));
  }, { passive: true });
  // Touch: horizontal swipes change cards; taps and vertical scrolling inside cards work normally.
  let sx = 0, sy = 0, st = 0;
  addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; st = Date.now(); }, { passive: true });
  addEventListener('touchend', (e) => {
    const t = e.changedTouches[0], dx = t.clientX - sx, dy = t.clientY - sy;
    if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.4 && Date.now() - st < 700) go(active + (dx < 0 ? 1 : -1));
  }, { passive: true });
  addEventListener('resize', layout);
  addEventListener('hashchange', () => { const i = cards.findIndex((c) => '#' + c.id === location.hash); if (i >= 0 && i !== active) go(i); });
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; } catch { b.textContent = 'Select it'; }
    setTimeout(() => (b.textContent = 'Copy'), 1600);
  }));
  layout();

  // Background: the original particle field and the faint ring of card planes, turning with the active card.
  try {
    const host = document.getElementById('three')!;
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    host.appendChild(renderer.domElement);
    const scene = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(75, 1, 0.1, 100); cam.position.z = 5;
    const count = innerWidth < 700 ? 600 : 1200;
    const pos = new Float32Array(count * 3); for (let i = 0; i < pos.length; i++) pos[i] = (Math.random() - 0.5) * 15;
    const g = new THREE.BufferGeometry(); g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    const particles = new THREE.Points(g, new THREE.PointsMaterial({ size: 0.022, color: 0x3ee6d6, transparent: true, opacity: 0.75 }));
    scene.add(particles);
    const ring = new THREE.Group(); scene.add(ring);
    cards.forEach((_, i) => {
      const plane = new THREE.Mesh(new THREE.PlaneGeometry(3.4, 4.4), new THREE.MeshBasicMaterial({ color: 0x3ee6d6, transparent: true, opacity: 0.05, side: THREE.DoubleSide }));
      const edge = new THREE.LineSegments(new THREE.EdgesGeometry(plane.geometry), new THREE.LineBasicMaterial({ color: 0x3ee6d6, transparent: true, opacity: 0.18 }));
      const a = (i / cards.length) * Math.PI * 2;
      plane.position.set(Math.sin(a) * 7, 0, Math.cos(a) * 7 - 4); plane.lookAt(0, 0, -4); edge.position.copy(plane.position); edge.rotation.copy(plane.rotation);
      ring.add(plane, edge);
    });
    let mx = 0, my = 0, tx = 0, ty = 0, rot = ringTarget;
    addEventListener('pointermove', (e) => { mx = (e.clientX / innerWidth) * 2 - 1; my = (e.clientY / innerHeight) * 2 - 1; }, { passive: true });
    const size = () => { renderer.setSize(innerWidth, innerHeight); cam.aspect = innerWidth / innerHeight; cam.updateProjectionMatrix(); };
    addEventListener('resize', size); size();
    const frame = () => {
      tx += (mx - tx) * 0.05; ty += (my - ty) * 0.05;
      if (!reduce) { particles.rotation.x += 0.0008 + ty * 0.0002; particles.rotation.y += 0.0008 + tx * 0.0002; ring.position.y = Math.sin(Date.now() * 0.001) * 0.08; }
      rot += (ringTarget - rot) * (reduce ? 1 : 0.08); ring.rotation.y = rot;
      renderer.render(scene, cam);
    };
    if (reduce) { frame(); setInterval(frame, 500); } else renderer.setAnimationLoop(frame);
    document.addEventListener('visibilitychange', () => renderer.setAnimationLoop(document.hidden || reduce ? null : frame));
  } catch { /* no WebGL: the gradient background stays, cards still work */ }
</script>
