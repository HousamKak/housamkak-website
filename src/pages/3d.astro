---
// 3D portfolio. The original housamkak.com idea (cards in a 3D ring over a teal particle field), rebuilt:
// - the cards live in a native horizontal scroll-snap strip, so phones get real swipe, momentum and taps;
//   JS only reads the scroll position and turns it into a 3D cover-flow (rotate, recede, dim, blur);
// - the WebGL background is a receding grid floor, drifting dust and a faint ring of card planes,
//   with the camera swinging toward the active card;
// - every card fits the viewport and scrolls inside itself; nothing is cut off.
import { site } from '../data/site';
import { io } from '../data/io';
import { allWork, media } from '../lib/data';

const work = await allWork();
const flag = ['blockforge', 'h-system', 'pos-store-management', 'anythyng', 'uipen'].map((s) => work.find((w) => w.id === s)!).filter(Boolean);
const cases = work.filter((w) => w.data.tier === 2);
const short: Record<string, string> = { 'pos-store-management': 'Store POS', 'h-system': 'H' };
const cards = [
  { id: 'home', label: 'Home' },
  { id: 'now', label: 'Experience' },
  ...flag.map((w) => ({ id: w.id, label: short[w.id] ?? w.data.title })),
  { id: 'more', label: 'More work' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];
const N = cards.length;
const idx = (i: number) => `${String(i + 1).padStart(2, '0')} / ${String(N).padStart(2, '0')}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>3D portfolio · {site.name}</title>
  <meta name="description" content={`${site.name}'s portfolio in 3D: ${site.thesis}`}>
  <link rel="canonical" href={`${site.url}/3d`}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta property="og:title" content={`3D portfolio · ${site.name}`}>
  <meta property="og:image" content={`${site.url}/og/default.png`}>
  <meta name="theme-color" content="#070D0F">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&family=JetBrains+Mono:wght@400;500;600&display=swap">
</head>
<body>
  <a class="skip" href="/work">Skip the 3D view and open the work index</a>
  <div id="three" aria-hidden="true"></div>
  <div class="vignette" aria-hidden="true"></div>

  <header class="bar">
    <a class="brand" href="/">HOUSAM KAK<small>3D portfolio</small></a>
    <a class="flat" href="/">Standard site</a>
  </header>

  <main class="strip" id="strip" tabindex="0" aria-roledescription="carousel" aria-label="Portfolio cards. Use the arrow keys to move between cards.">
    <section class="card" id="home" aria-label="Home">
      <div class="card-in">
        <div class="head"><span class="idx">{idx(0)}</span><span class="tag">Hello</span></div>
        <div class="body center">
          <img class="photo" src="/img/profile.webp" alt="Portrait of Housam Kak" width="480" height="720">
          <h1 class="name">Housam Kak</h1>
          <p class="role">Engineer and mathematician · {site.location}</p>
          <p class="thesis">{site.thesis}</p>
          <p class="muted">{site.lede}</p>
          <div class="btns"><a class="btn" href="/work">See every project</a><a class="btn ghost" href={site.cvPdf}>Download CV</a></div>
          <p class="hint"><span class="desk">Scroll, drag or use ← →</span><span class="phone">Swipe sideways</span> to move through the cards</p>
        </div>
      </div>
    </section>

    <section class="card" id="now" aria-label="Experience">
      <div class="card-in">
        <div class="head"><span class="idx">{idx(1)}</span><span class="tag">Experience</span></div>
        <div class="body">
          <h2 class="title">Experience</h2>
          <div class="exp">
            <h3>Product Lead, AI Systems Pilot</h3>
            <p class="meta">A global investment firm · 2024 to present</p>
            <ul>
              <li>Lead a pilot AI systems team: product direction and senior software for a conversational platform that connects staff to company data.</li>
              <li>MCP integrations, graph access, Azure Cosmos DB and Azure AI Search, on distributed microservices.</li>
            </ul>
          </div>
          <div class="exp">
            <h3>Consultant, OmniVista Solutions</h3>
            <p class="meta">Financial technology consultancy, Dubai · Apr 2023 to present</p>
            <ul>
              <li>Requirements, architecture and delivery for investment-firm clients: an analyst recommendation portal, data integration services and Power BI exposure reporting.</li>
              <li>Portfolio application load time cut by about 70%. Client support operations across 2,500+ tickets.</li>
            </ul>
          </div>
          <div class="exp">
            <h3>Independent systems</h3>
            <p class="meta">2026</p>
            <ul><li>Five flagship systems and two dozen tools. They are the next cards.</li></ul>
          </div>
        </div>
      </div>
    </section>

    {flag.map((w, k) => {
      const m = media(w.id);
      const x = io[w.id];
      return (
        <section class="card flagship" id={w.id} aria-label={w.data.title}>
          <div class="card-in">
            {m.hero && <div class="shot"><img src={m.hero} alt={m.heroAlt ?? w.data.title} loading={k < 2 ? 'eager' : 'lazy'}></div>}
            <div class="head over"><span class="idx">{idx(k + 2)}</span><span class="tag">Flagship {k + 1} of 5</span></div>
            <div class="body">
              <h2 class="title">{w.data.title}</h2>
              <p class="hook">{w.data.hook}</p>
              {x && <dl class="io"><div><dt>In</dt><dd class="mono">{x.in}</dd></div><div><dt>Out</dt><dd>{x.out}</dd></div></dl>}
              <p class="muted small">{w.data.role} · {w.data.period}</p>
              <div class="btns"><a class="btn" href={`/work/${w.id}`}>Read the case study</a>{w.data.links.live && <a class="btn ghost" href={w.data.links.live}>Live site</a>}</div>
            </div>
          </div>
        </section>
      );
    })}

    <section class="card" id="more" aria-label="More work">
      <div class="card-in">
        <div class="head"><span class="idx">{idx(flag.length + 2)}</span><span class="tag">{cases.length} case studies</span></div>
        <div class="body">
          <h2 class="title">More work</h2>
          <ul class="list">
            {cases.map((w) => <li><a href={`/work/${w.id}`}><b>{w.data.title}</b><span>{w.data.hook}</span></a></li>)}
          </ul>
          <div class="btns"><a class="btn ghost" href="/work">All {work.length} projects</a></div>
        </div>
      </div>
    </section>

    <section class="card" id="skills" aria-label="Skills and education">
      <div class="card-in">
        <div class="head"><span class="idx">{idx(flag.length + 3)}</span><span class="tag">Skills</span></div>
        <div class="body">
          <h2 class="title">Skills and education</h2>
          <h3 class="sub">AI and architecture</h3>
          <p class="tags"><span>Conversational AI</span><span>MCP</span><span>Agent orchestration</span><span>Graph and search</span><span>Microservices</span></p>
          <h3 class="sub">Engineering</h3>
          <p class="tags"><span>TypeScript</span><span>Python</span><span>C#</span><span>C++</span><span>SQL</span><span>Kotlin</span><span>React</span><span>Node.js</span><span>Three.js</span></p>
          <h3 class="sub">Cloud and data</h3>
          <p class="tags"><span>Azure</span><span>AWS</span><span>Cloudflare</span><span>OpenTofu</span><span>PostgreSQL</span><span>SQLite</span><span>CI/CD</span></p>
          <h3 class="sub">Education</h3>
          <p>B.E. Mechanical Engineering, major in Mathematics, American University of Beirut (2018 to 2022). Mastercard Foundation Scholar.</p>
          <p class="muted small">Graduation project: an autonomous miniature racing car with camera-based lane perception and pure-pursuit control.</p>
        </div>
      </div>
    </section>

    <section class="card" id="contact" aria-label="Contact">
      <div class="card-in">
        <div class="head"><span class="idx">{idx(N - 1)}</span><span class="tag">Contact</span></div>
        <div class="body center">
          <h2 class="title">Let's talk</h2>
          <p class="muted">The fastest way to reach me is email.</p>
          <p class="email mono">{site.email}</p>
          <button class="btn" type="button" data-copy={site.email}>Copy email address</button>
          <div class="links">
            <a href={site.github}>GitHub</a><a href={site.linkedin}>LinkedIn</a><a href={site.blog}>Blog</a><a href={site.blockforge}>BlockForge</a><a href={site.cvPdf}>CV (PDF)</a>
          </div>
          <p class="muted small">Based in {site.location}. Open to remote and on-site work.</p>
        </div>
      </div>
    </section>
  </main>

  <nav class="dock" aria-label="Cards">
    <button class="arrow" type="button" data-step="-1" aria-label="Previous card"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
    <div class="menu" id="menu">
      {cards.map((c, i) => <button type="button" data-go={i} aria-controls={c.id}><i>{String(i + 1).padStart(2, '0')}</i>{c.label}</button>)}
    </div>
    <button class="arrow" type="button" data-step="1" aria-label="Next card"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
    <div class="progress" aria-hidden="true"><span id="bar"></span></div>
  </nav>
</body>
</html>

<style is:global>
  :root {
    --bg: #070D0F; --surface: #0E1A1D; --surface-2: #132428; --ink: #EAF6F4; --muted: #9FB9B5;
    --teal: #3EE6D6; --teal-dim: rgba(62, 230, 214, .2); --amber: #F2A600; --cardW: min(460px, calc(100vw - 56px));
    --cardH: min(680px, calc(100dvh - 176px)); color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body { background: var(--bg); color: var(--ink); font: 400 16px/1.6 Archivo, system-ui, sans-serif; font-variation-settings: "wdth" 100; overflow: hidden; -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--teal); outline-offset: 3px; border-radius: 4px; }
  .skip { position: absolute; left: -9999px; z-index: 60; }
  .skip:focus { left: 16px; top: 12px; background: var(--teal); color: #021a17; padding: 8px 12px; }
  .mono { font-family: "JetBrains Mono", ui-monospace, monospace; }

  #three { position: fixed; inset: 0; z-index: 0; background: radial-gradient(120% 80% at 50% 30%, #0F2428 0%, var(--bg) 62%); }
  #three canvas { display: block; }
  .vignette { position: fixed; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(130% 100% at 50% 45%, transparent 55%, rgba(0, 0, 0, .55)); }

  /* top bar */
  .bar { position: fixed; inset: 0 0 auto; z-index: 30; display: flex; justify-content: space-between; align-items: center; gap: 12px;
    padding: max(14px, env(safe-area-inset-top)) max(20px, env(safe-area-inset-right)) 0 max(20px, env(safe-area-inset-left)); }
  .brand { text-decoration: none; font: 700 17px/1 Archivo, sans-serif; font-variation-settings: "wdth" 125; letter-spacing: .04em; }
  .brand small { display: block; margin-top: 5px; font: 500 10.5px/1 "JetBrains Mono", monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--teal); }
  .flat { font-size: 13px; font-weight: 600; text-decoration: none; color: var(--ink); border: 1px solid var(--teal-dim); border-radius: 99px; padding: 8px 14px; background: rgba(7, 13, 15, .6); backdrop-filter: blur(6px); }
  .flat:hover { border-color: var(--teal); color: var(--teal); }

  /* the strip: native horizontal scroll with snap; JS adds the 3D */
  .strip { position: fixed; inset: 0; z-index: 10; display: flex; align-items: center; gap: clamp(12px, 3vw, 40px);
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain;
    padding-inline: calc((100vw - var(--cardW)) / 2); perspective: 1400px; perspective-origin: 50% 45%; outline: none; padding-top: 18px; }
  .strip::-webkit-scrollbar { display: none; }
  .card { flex: none; width: var(--cardW); height: var(--cardH); scroll-snap-align: center; scroll-snap-stop: always; transform-style: preserve-3d; }
  .card-in { will-change: transform, opacity; }
  .card-in { position: relative; height: 100%; display: flex; flex-direction: column; overflow: hidden; border-radius: 22px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface) 38%); border: 1px solid var(--teal-dim);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, .8), 0 0 0 1px rgba(255, 255, 255, .02) inset; transition: border-color .3s, box-shadow .3s; }
  .card.is-active .card-in { border-color: rgba(62, 230, 214, .55); box-shadow: 0 40px 90px -30px rgba(0, 0, 0, .85), 0 0 50px -10px rgba(62, 230, 214, .25); }
  .card-in::after { content: ""; position: absolute; inset: 0; pointer-events: none; border-radius: inherit; background: linear-gradient(115deg, rgba(255, 255, 255, .07), transparent 30%); opacity: var(--sheen, .4); }
  .head { display: flex; justify-content: space-between; align-items: center; padding: 16px 22px 0; font: 500 11px/1 "JetBrains Mono", monospace; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .head .idx { color: var(--teal); }
  .head.over { position: absolute; inset: 0 0 auto; z-index: 2; padding: 14px 16px; }
  .head.over span { background: rgba(7, 13, 15, .72); padding: 6px 9px; border-radius: 99px; backdrop-filter: blur(4px); }
  .body { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 14px 24px 22px; scrollbar-width: thin; scrollbar-color: rgba(62, 230, 214, .4) transparent;
    -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - 26px), transparent); mask-image: linear-gradient(180deg, #000 calc(100% - 26px), transparent); }
  .body.center { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .body p { margin: 0 0 12px; }

  .photo { width: 120px; height: 120px; object-fit: cover; object-position: 50% 18%; border-radius: 50%; border: 2px solid var(--teal); box-shadow: 0 0 30px -6px rgba(62, 230, 214, .5); margin: 10px 0 12px; }
  .name { margin: 0 0 4px; font-size: 30px; font-weight: 800; font-variation-settings: "wdth" 112; letter-spacing: -.01em; }
  .role { font: 500 12px/1.4 "JetBrains Mono", monospace; letter-spacing: .06em; text-transform: uppercase; color: var(--teal); }
  .thesis { font-size: 22px; font-weight: 700; line-height: 1.25; font-variation-settings: "wdth" 108; text-wrap: balance; }
  .title { margin: 4px 0 10px; font-size: 28px; font-weight: 800; line-height: 1.1; font-variation-settings: "wdth" 112; letter-spacing: -.01em; text-wrap: balance; }
  .muted { color: var(--muted); }
  .small { font-size: 13.5px; }
  .hint { margin-top: auto !important; padding-top: 14px; font-size: 12.5px; color: var(--muted); }
  .hint .phone { display: none; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .center .btns { justify-content: center; }
  .btn { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font: 600 14.5px/1 Archivo, sans-serif; padding: 0 18px; border-radius: 99px; background: var(--teal); color: #021a17; border: 1px solid var(--teal); cursor: pointer; }
  .btn:hover { background: #82F2E8; }
  .btn.ghost { background: transparent; color: var(--teal); }
  .btn.ghost:hover { background: rgba(62, 230, 214, .1); }

  .flagship .shot { position: relative; flex: none; height: 42%; min-height: 150px; overflow: hidden; background: #000; border-bottom: 1px solid var(--teal-dim); }
  .flagship .shot img { width: 100%; height: 100%; object-fit: cover; object-position: left top; display: block; transform: scale(var(--zoom, 1.06)); transition: transform 1s cubic-bezier(.2, .7, .2, 1); }
  .flagship.is-active .shot img { --zoom: 1; }
  .flagship .shot::after { content: ""; position: absolute; inset: auto 0 0; height: 40%; background: linear-gradient(transparent, rgba(14, 26, 29, .9)); }
  .hook { font-size: 17px; font-weight: 600; line-height: 1.4; }
  .io { margin: 0 0 12px; border-top: 1px solid var(--teal-dim); font-size: 14px; }
  .io div { display: grid; grid-template-columns: 38px 1fr; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--teal-dim); }
  .io dt { font: 600 10.5px/1.75 "JetBrains Mono", monospace; text-transform: uppercase; letter-spacing: .1em; color: var(--amber); }
  .io dd { margin: 0; overflow-wrap: anywhere; }
  .io dd.mono { font-size: 13px; color: #d6eeea; }

  .exp { padding: 12px 0; border-top: 1px solid var(--teal-dim); }
  .exp h3 { margin: 0; font-size: 17px; font-weight: 700; }
  .meta { font: 500 12px/1.5 "JetBrains Mono", monospace; color: var(--teal); margin: 3px 0 8px !important; }
  .exp ul { margin: 0; padding-left: 18px; }
  .exp li { margin-bottom: 6px; font-size: 14.5px; line-height: 1.5; }
  .exp li::marker { color: var(--teal); }
  .list { list-style: none; padding: 0; margin: 0 0 14px; }
  .list li { border-top: 1px solid var(--teal-dim); }
  .list a { display: grid; gap: 2px; padding: 10px 0; text-decoration: none; }
  .list b { font-size: 15.5px; }
  .list span { font-size: 13.5px; color: var(--muted); line-height: 1.45; }
  .list a:hover b { color: var(--teal); }
  .sub { margin: 14px 0 6px; font: 600 11px/1.3 "JetBrains Mono", monospace; text-transform: uppercase; letter-spacing: .1em; color: var(--teal); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tags span { font-size: 13px; border: 1px solid var(--teal-dim); border-radius: 99px; padding: 4px 11px; background: rgba(62, 230, 214, .04); }
  .email { font-size: 15px; margin: 10px 0 14px !important; overflow-wrap: anywhere; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 18px 0 16px; }
  .links a { display: inline-flex; align-items: center; min-height: 40px; text-decoration: none; font-size: 14px; border: 1px solid var(--teal-dim); border-radius: 99px; padding: 0 14px; }
  .links a:hover { border-color: var(--teal); color: var(--teal); }

  /* dock */
  .dock { position: fixed; z-index: 30; left: 50%; bottom: max(14px, env(safe-area-inset-bottom)); transform: translateX(-50%); display: flex; align-items: center; gap: 4px;
    max-width: calc(100vw - 24px); padding: 6px; border-radius: 99px; background: rgba(7, 13, 15, .78); border: 1px solid var(--teal-dim); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .menu { display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; min-width: 0; }
  .menu::-webkit-scrollbar { display: none; }
  .dock button { font: 500 13px/1 Archivo, sans-serif; color: var(--muted); background: none; border: 0; border-radius: 99px; padding: 0 12px; min-height: 40px; cursor: pointer; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }
  .dock button i { font: normal 500 10.5px/1 "JetBrains Mono", monospace; opacity: .7; }
  .dock button:hover { color: var(--ink); }
  .dock button[aria-current="true"] { background: var(--teal); color: #021a17; font-weight: 700; }
  .dock button[aria-current="true"] i { opacity: 1; }
  .dock .arrow { flex: none; width: 40px; padding: 0; justify-content: center; color: var(--teal); }
  .dock .arrow:hover { background: rgba(62, 230, 214, .12); }
  .progress { position: absolute; left: 22px; right: 22px; bottom: -1px; height: 2px; border-radius: 2px; overflow: hidden; }
  .progress span { display: block; height: 100%; width: 0; background: var(--teal); transition: width .3s; }

  @media (max-width: 640px) {
    :root { --cardW: calc(100vw - 40px); --cardH: calc(100dvh - 158px); }
    .strip { gap: 10px; padding-top: 22px; }
    .bar { padding-top: max(12px, env(safe-area-inset-top)); }
    .brand { font-size: 15px; }
    .head { padding: 14px 18px 0; }
    .body { padding: 12px 18px 20px; }
    .title { font-size: 24px; }
    .thesis { font-size: 20px; }
    .name { font-size: 26px; }
    .photo { width: 96px; height: 96px; margin-top: 4px; }
    .hint .desk { display: none; } .hint .phone { display: inline; }
    .dock button:not(.arrow) { padding: 0 10px; }
    .dock button i { display: none; }
  }
  @media (max-height: 640px) and (min-width: 641px) { :root { --cardH: calc(100dvh - 140px); } }
  @media (prefers-reduced-motion: reduce) { .flagship .shot img { transition: none; } .strip { scroll-behavior: auto; } }
</style>

<script>
  import * as THREE from 'three';

  const strip = document.getElementById('strip')!;
  const cards = [...strip.querySelectorAll<HTMLElement>('.card')];
  const menu = [...document.querySelectorAll<HTMLButtonElement>('[data-go]')];
  const bar = document.getElementById('bar')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const N = cards.length;
  let active = -1;
  let focus = 0; // continuous card position, 0..N-1, drives the 3D background

  const toCard = (i: number, smooth = !reduce) => {
    const c = cards[Math.max(0, Math.min(N - 1, i))];
    strip.scrollTo({ left: c.offsetLeft - (strip.clientWidth - c.offsetWidth) / 2, behavior: smooth ? 'smooth' : 'auto' });
  };

  // Turn scroll position into a cover-flow: each card rotates, recedes, dims and blurs by its distance from the centre.
  function paint() {
    const mid = strip.scrollLeft + strip.clientWidth / 2;
    const step = cards[1] ? cards[1].offsetLeft - cards[0].offsetLeft : 1;
    let best = 0, bestD = Infinity;
    cards.forEach((c, i) => {
      const inner = c.firstElementChild as HTMLElement;
      const d = (c.offsetLeft + c.offsetWidth / 2 - mid) / step; // -1 = one card to the left
      const a = Math.min(Math.abs(d), 3);
      if (Math.abs(d) < bestD) { bestD = Math.abs(d); best = i; }
      const ry = Math.max(-1, Math.min(1, d)) * -38;
      const tz = -a * 160, tx = -Math.sign(d) * Math.max(0, a - 1) * step * 0.35;
      inner.style.transform = `translateX(${tx}px) translateZ(${tz}px) rotateY(${ry}deg)`;
      inner.style.opacity = String(Math.max(0, 1 - a * 0.55));
      inner.style.filter = a > 0.08 ? `blur(${Math.min(a, 1.4) * 2.2}px) brightness(${1 - Math.min(a, 1) * 0.35})` : '';
      inner.style.setProperty('--sheen', String(0.25 + Math.max(0, 0.5 - Math.abs(d) * 0.5)));
    });
    focus = (strip.scrollLeft) / step;
    if (best !== active) setActive(best);
  }
  function setActive(i: number) {
    active = i;
    cards.forEach((c, k) => {
      c.classList.toggle('is-active', k === i);
      c.setAttribute('aria-hidden', String(k !== i));
      c.querySelectorAll<HTMLElement>('a, button, .body').forEach((el) => (el.tabIndex = k === i ? 0 : -1));
    });
    menu.forEach((b, k) => b.setAttribute('aria-current', String(k === i)));
    const mb = menu[i];
    if (mb) { const m = mb.parentElement!; m.scrollTo({ left: mb.offsetLeft - (m.clientWidth - mb.offsetWidth) / 2, behavior: reduce ? 'auto' : 'smooth' }); }
    bar.style.width = `${((i + 1) / N) * 100}%`;
    history.replaceState(null, '', '#' + cards[i].id);
  }
  let raf = 0;
  strip.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(paint); }, { passive: true });
  addEventListener('resize', () => { paint(); toCard(active, false); });

  // Controls
  document.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => toCard(active + Number(b.dataset.step))));
  menu.forEach((b) => b.addEventListener('click', () => toCard(Number(b.dataset.go))));
  addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'PageDown') { e.preventDefault(); toCard(active + 1); }
    if (e.key === 'ArrowLeft' || e.key === 'PageUp') { e.preventDefault(); toCard(active - 1); }
    if (e.key === 'Home') toCard(0);
    if (e.key === 'End') toCard(N - 1);
  });
  // Vertical wheel moves between cards, unless the card under the pointer can still scroll that way.
  let lock = 0;
  strip.addEventListener('wheel', (e) => {
    if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return; // trackpad sideways: native scroll
    const body = (e.target as HTMLElement).closest<HTMLElement>('.body');
    if (body && body.scrollHeight > body.clientHeight + 1) {
      const atTop = body.scrollTop <= 0, atEnd = body.scrollTop + body.clientHeight >= body.scrollHeight - 1;
      if ((e.deltaY > 0 && !atEnd) || (e.deltaY < 0 && !atTop)) return;
    }
    e.preventDefault();
    const now = performance.now();
    if (now < lock || Math.abs(e.deltaY) < 8) return;
    lock = now + 520;
    toCard(active + (e.deltaY > 0 ? 1 : -1));
  }, { passive: false });
  // Mouse drag on desktop (touch already scrolls natively).
  let dragX = -1, dragLeft = 0, moved = false;
  strip.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse' || (e.target as HTMLElement).closest('a, button, .body')) return; dragX = e.clientX; dragLeft = strip.scrollLeft; moved = false; strip.style.scrollSnapType = 'none'; });
  addEventListener('pointermove', (e) => { if (dragX < 0) return; const dx = e.clientX - dragX; if (Math.abs(dx) > 4) moved = true; strip.scrollLeft = dragLeft - dx; });
  addEventListener('pointerup', () => { if (dragX < 0) return; dragX = -1; strip.style.scrollSnapType = ''; if (moved) { const mid = strip.scrollLeft + strip.clientWidth / 2; let b = 0, bd = Infinity; cards.forEach((c, i) => { const d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid); if (d < bd) { bd = d; b = i; } }); toCard(b); } });
  // Clicking a side card brings it to the front.
  cards.forEach((c, i) => c.addEventListener('click', (e) => { if (i !== active && !moved) { e.preventDefault(); toCard(i); } }, true));
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const t = b.textContent;
    try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Copied'; } catch { b.textContent = 'Select the address above'; }
    setTimeout(() => (b.textContent = t), 1800);
  }));

  // Start on the card in the URL hash.
  const start = Math.max(0, cards.findIndex((c) => '#' + c.id === location.hash));
  requestAnimationFrame(() => { toCard(start, false); paint(); });
  addEventListener('hashchange', () => { const i = cards.findIndex((c) => '#' + c.id === location.hash); if (i >= 0 && i !== active) toCard(i); });

  // Background: receding grid floor, drifting dust, and a faint ring of card frames; the camera swings with the strip.
  try {
    const host = document.getElementById('three')!;
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true, powerPreference: 'low-power' });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 1.75));
    host.appendChild(renderer.domElement);
    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0x070d0f, 8, 34);
    const cam = new THREE.PerspectiveCamera(60, 1, 0.1, 100);
    const teal = 0x3ee6d6;

    const grid = new THREE.GridHelper(80, 80, teal, teal);
    (grid.material as THREE.Material).transparent = true; (grid.material as THREE.Material).opacity = 0.16;
    grid.position.y = -3.2; scene.add(grid);

    const count = innerWidth < 700 ? 700 : 1400;
    const pos = new Float32Array(count * 3);
    for (let i = 0; i < count; i++) { pos[i * 3] = (Math.random() - 0.5) * 40; pos[i * 3 + 1] = Math.random() * 12 - 3; pos[i * 3 + 2] = (Math.random() - 0.5) * 40; }
    const dustGeo = new THREE.BufferGeometry(); dustGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    const dust = new THREE.Points(dustGeo, new THREE.PointsMaterial({ size: 0.045, color: teal, transparent: true, opacity: 0.55, sizeAttenuation: true }));
    scene.add(dust);

    const ring = new THREE.Group(); scene.add(ring);
    const R = 11;
    for (let i = 0; i < N; i++) {
      const a = (i / N) * Math.PI * 2;
      const frame = new THREE.LineSegments(new THREE.EdgesGeometry(new THREE.PlaneGeometry(2.6, 3.6)), new THREE.LineBasicMaterial({ color: teal, transparent: true, opacity: 0.22 }));
      frame.position.set(Math.sin(a) * R, 0.4, Math.cos(a) * R); frame.lookAt(0, 0.4, 0); ring.add(frame);
      const post = new THREE.Mesh(new THREE.CylinderGeometry(0.02, 0.02, 3.6, 6), new THREE.MeshBasicMaterial({ color: teal, transparent: true, opacity: 0.12 }));
      post.position.set(Math.sin(a) * R, -1.4, Math.cos(a) * R); ring.add(post);
    }

    let mx = 0, my = 0, sx = 0, sy = 0, f = focus;
    addEventListener('pointermove', (e) => { mx = (e.clientX / innerWidth) * 2 - 1; my = (e.clientY / innerHeight) * 2 - 1; }, { passive: true });
    const size = () => { renderer.setSize(innerWidth, innerHeight); cam.aspect = innerWidth / innerHeight; cam.updateProjectionMatrix(); };
    addEventListener('resize', size); size();
    const frame = (t: number) => {
      sx += (mx - sx) * 0.04; sy += (my - sy) * 0.04; f += (focus - f) * (reduce ? 1 : 0.08);
      const ang = -(f / N) * Math.PI * 2;
      ring.rotation.y = ang;
      const sway = reduce ? 0 : Math.sin(t * 0.0003) * 0.4;
      cam.position.set(sx * 1.2 + sway, 1.1 - sy * 0.6, 7.5);
      cam.lookAt(0, 0.2, -4);
      grid.position.z = reduce ? 0 : ((t * 0.0006) % 1);
      if (!reduce) dust.rotation.y = t * 0.00002;
      renderer.render(scene, cam);
    };
    if (reduce) { const loop = () => frame(0); strip.addEventListener('scroll', () => requestAnimationFrame(loop), { passive: true }); loop(); }
    else renderer.setAnimationLoop(frame);
    document.addEventListener('visibilitychange', () => { if (!reduce) renderer.setAnimationLoop(document.hidden ? null : frame); });
  } catch { /* no WebGL: the gradient stays and the cards still work */ }
</script>
