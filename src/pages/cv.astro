---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../data/site';
const [cv] = await getCollection('cv');
const Content = cv ? (await render(cv)).Content : null;
---
<Base title="CV" nav="cv" sheet="Curriculum vitae" dwg="03" description={`Curriculum vitae of ${site.name}: enterprise AI product and software delivery, independent systems, engineering and mathematics.`}>
  <header class="cs-head">
    <div><p class="label">Curriculum vitae</p>{cv && <p class="label" style="margin-top:6px">Rev {cv.data.updated.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</p>}</div>
    <div>
      <h1>{site.name}</h1>
      <p class="lede">{site.tagline}</p>
      <div class="cta"><a class="btn" href={site.cvPdf}>Download the PDF</a><a class="btn ghost" href="/work">See the work</a></div>
    </div>
  </header>
  <div class="case" style="grid-template-columns:180px minmax(0,1fr);gap:24px">
    <span></span>
    <div class="prose cv">{Content ? <Content /> : <p>The CV is being revised. The PDF has the current version.</p>}</div>
  </div>
</Base>
<style is:global>
  .cv h2 { border-top: var(--stroke-heavy) solid var(--ink); padding-top: 12px; margin-top: 1.6em; }
  .cv h2:first-child { margin-top: 0; }
  @media (max-width: 760px) { .case { grid-template-columns: 1fr !important; } }
</style>
