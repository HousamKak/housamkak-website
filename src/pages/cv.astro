---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../data/site';
const [cv] = await getCollection('cv');
const rendered = cv ? await render(cv) : null;
const Content = rendered?.Content;
---
<Base title="CV" nav="cv" description={`Curriculum vitae of ${site.name}: enterprise AI product and software delivery, independent systems, engineering and mathematics.`}>
  <div class="wrap"><div class="inner">
    <header class="cs-head">
      <div class="kicker">Curriculum vitae{cv && ` · updated ${cv.data.updated.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}`}</div>
      <h1>{site.name}</h1>
      <p class="lede">{site.tagline}</p>
      <p class="links"><a href={site.cvPdf}>Download PDF ↗</a></p>
    </header>
    <div class="prose cv" style="margin-bottom:72px">
      {Content ? <Content /> : <p>The CV is being refreshed. The PDF link above has the current version.</p>}
    </div>
  </div></div>
</Base>
<style is:global>
  .cv h2 { border-top: 2px solid var(--ink); padding-top: 12px; }
  .cv h3 { margin-bottom: .1em; }
  .cv h3 + p em, .cv h3 + p { color: var(--muted); }
</style>
